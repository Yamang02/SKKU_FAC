{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug React Native Web",
            "type": "reactnativedirect",
            "request": "launch",
            "platform": "web",
            "webRoot": "${workspaceFolder}/frontend/src",
            "url": "http://localhost:3003",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack:///./src/*": "${webRoot}/*"
            }
        },
        {
            "name": "Attach to React Native Web",
            "type": "reactnativedirect",
            "request": "attach",
            "platform": "web",
            "webRoot": "${workspaceFolder}/frontend/src",
            "url": "http://localhost:3003",
            "sourceMaps": true
        },
        {
            "name": "Debug Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3003",
            "webRoot": "${workspaceFolder}/frontend/src",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack:///./src/*": "${webRoot}/*"
            }
        }
    ]
}
