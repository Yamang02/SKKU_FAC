{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        /* Path mapping */
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@/apps/*": [
                "src/apps/*"
            ],
            "@/shared/*": [
                "src/shared/*"
            ],
            "@/features/*": [
                "src/features/*"
            ],
            "@/assets/*": [
                "src/assets/*"
            ],
            // 레거시 호환성
            "@/components/*": [
                "src/components/*"
            ],
            "@/pages/*": [
                "src/pages/*"
            ],
            "@/hooks/*": [
                "src/hooks/*"
            ],
            "@/services/*": [
                "src/services/*"
            ],
            "@/stores/*": [
                "src/stores/*"
            ],
            "@/contexts/*": [
                "src/contexts/*"
            ],
            "@/utils/*": [
                "src/utils/*"
            ],
            "@/types/*": [
                "src/types/*"
            ],
            "@/config/*": [
                "src/config/*"
            ]
        },
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": [
        "src"
    ]
}
