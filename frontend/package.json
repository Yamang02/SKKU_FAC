{
    "name": "skku-gallery-frontend",
    "version": "1.0.0",
    "description": "SKKU 순수미술동아리 갤러리 - React Native Web Frontend",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "webpack serve --config config/webpack/webpack.dev.js --open",
        "build": "webpack --config config/webpack/webpack.prod.js",
        "build:dev": "webpack --config config/webpack/webpack.dev.js",
        "preview": "npm run build && npx serve dist",
        "lint": "eslint src/ --fix",
        "format": "prettier --write src/",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-native-web": "^0.19.12"
    },
    "devDependencies": {
        "@babel/core": "^7.23.0",
        "@babel/preset-env": "^7.23.0",
        "@babel/preset-react": "^7.22.0",
        "@babel/preset-typescript": "^7.23.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "babel-loader": "^9.1.0",
        "eslint": "^8.57.1",
        "file-loader": "^6.2.0",
        "html-webpack-plugin": "^5.5.0",
        "prettier": "^3.4.2",
        "typescript": "^5.2.0",
        "webpack": "^5.88.0",
        "webpack-cli": "^5.1.0",
        "webpack-dev-server": "^4.15.0",
        "webpack-merge": "^5.9.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
