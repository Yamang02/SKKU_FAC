{
    "name": "skku-fac-gallery",
    "version": "1.0.0",
    "description": "SKKU Faculty Art Gallery Website",
    "main": "server.js",
    "type": "module",
    "engines": {
        "node": ">=14.0.0"
    },
    "scripts": {
        "dev": "cd backend && docker-compose up app",
        "dev:backend": "cd backend && docker-compose up app",
        "dev:frontend": "cd frontend && npm run dev",
        "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "start": "cd backend && docker-compose up app",
        "docker:down": "cd backend && docker-compose down",
        "docker:build": "cd backend && docker-compose build",
        "docker:logs": "cd backend && docker-compose logs -f app"
    },
    "dependencies": {
        "all": "^0.0.0",
        "bcrypt": "^5.1.1",
        "body-parser": "^1.20.2",
        "brace-expansion": "2.0.2",
        "compression": "^1.8.0",
        "connect-flash": "^0.1.1",
        "connect-redis": "^8.1.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "ejs": "^3.1.9",
        "express": "^4.18.2",
        "express-basic-auth": "^1.2.1",
        "express-rate-limit": "^7.5.0",
        "express-session": "^1.18.1",
        "helmet": "^8.1.0",
        "html2canvas": "^1.4.1",
        "joi": "^17.9.2",
        "jsonwebtoken": "^9.0.2",
        "method-override": "^3.0.0",
        "module-alias": "^2.2.3",
        "morgan": "^1.10.0",
        "multer": "2.0.1",
        "multer-storage-cloudinary": "^4.0.0",
        "mysql2": "^3.14.0",
        "node-forge": "^1.3.1",
        "nodemailer": "^6.10.1",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "playwright": "^1.52.0",
        "qrcode": "^1.5.4",
        "redis": "^5.1.0",
        "sequelize": "^6.37.7",
        "sharp": "^0.33.5",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "task-master-ai": "^0.15.0",
        "uuid": "^11.1.0",
        "winston": "^3.8.2",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.26.10",
        "@babel/node": "^7.26.0",
        "@babel/preset-env": "^7.26.9",
        "@babel/register": "^7.25.9",
